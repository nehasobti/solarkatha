{
  "name": "solarkatha-pdf-service",
  "private": true,
  "version": "0.1.0",
  "description": "Renders SolarKatha proposal PDFs (Hindi/English) from an HTML template with headless Chromium.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/template.test.ts",
    "render:sample": "tsx scripts/render-sample.ts"
  },
  "dependencies": {
    "@sparticuz/chromium": "^153.0.0",
    "puppeteer-core": "^25.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
